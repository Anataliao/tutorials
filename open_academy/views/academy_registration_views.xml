<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_open_academy_registration_list" model="ir.ui.view">
        <field name="name">open.academy.registration.list</field>
        <field name="model">open.academy.registration</field>
        <field name="arch" type="xml">
            <list decoration-success="active"
                    decoration-danger="not active">
                <field name="sequence" widget="handle"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="current_semester"/>
                <field name="semester_cost"/>
                <field name="total_to_pay"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_open_academy_registration_form" model="ir.ui.view">
        <field name="name">open.academy.registration.form</field>
        <field name="model">open.academy.registration</field>
        <field name="arch" type="xml">
            <form string="Registration">
                <sheet>

                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="program_id"/>
                            <field name="current_semester"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="semester_cost" readonly="1"/>
                            <field name="insurance_value" readonly="1"/>
                            <field name="total_to_pay" readonly="1"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_academy_registration" model="ir.actions.act_window">
        <field name="name">Registrations</field>
        <field name="res_model">open.academy.registration</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
