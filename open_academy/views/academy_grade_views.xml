<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_open_academy_grade_list" model="ir.ui.view">
        <field name="name">open.academy.grade.list</field>
        <field name="model">open.academy.grade</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="cut1"/>
                <field name="cut2"/>
                <field name="cut3"/>
                <field name="final_grade"/>
                <field name="approved"/>
            </list>
        </field>
    </record>

    <record id="view_open_academy_grade_form" model="ir.ui.view">
        <field name="name">open.academy.grade.form</field>
        <field name="model">open.academy.grade</field>
        <field name="arch" type="xml">
            <form string="Grade">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="1"/>
                            <field name="subject_id" readonly="1"/>
                            <field name="teacher_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="cut1"/>
                            <field name="cut2"/>
                            <field name="cut3"/>
                            <field name="final_grade" readonly="1"/>
                            <field name="approved" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_academy_grade" model="ir.actions.act_window">
        <field name="name">My Assigned Grades</field>
        <field name="res_model">open.academy.grade</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('teacher_id','=',uid)]</field>
    </record>

</odoo>
