<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_open_academy_enrolment_list" model="ir.ui.view">
    <field name="name">open.academy.enrolment.list</field>
    <field name="model">open.academy.enrolment</field>
    <field name="arch" type="xml">
        <list>
            <field name="user_id"/>
            <field name="student_id"/>
            <field name="program_id"/>
            <field name="current_semester"/>
            <field name="subject_id"/>
            <field name="credits"/>
        </list>
    </field>
</record>
<record id="view_open_academy_enrolment_form" model="ir.ui.view">
    <field name="name">open.academy.enrolment.form</field>
    <field name="model">open.academy.enrolment</field>
    <field name="arch" type="xml">
        <form string="Subject Enrolment">
            <sheet> 
                <group>
                        <group>
                            <field name="user_id" readonly="1" />
                            <field name="registration_id"/>
                            <field name="student_id" readonly="1"/>
                            <field name="program_id" readonly="1"/>
                            <field name="current_semester" readonly="1"/>

                            <field name="subject_id"
                                domain="[
                                    '|',
                                    ('is_global','=',True),
                                    ('program_id','=',program_id),
                                    ('semester','=',current_semester)
                                ]"/>
                        </group>

                        <group>
                            <field name="credits" readonly="1"/>
                        </group>
                    </group>
            </sheet>
        </form>
    </field>
</record>
<record id="action_open_academy_enrolment" model="ir.actions.act_window">
    <field name="name">Enrolments</field>
    <field name="res_model">open.academy.enrolment</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('user_id','=',uid)]</field>
</record>
</odoo>
