<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_open_academy_subject_list" model="ir.ui.view">
        <field name="name">open.academy.subject.list</field>
        <field name="model">open.academy.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="category"/>
                <field name="semester"/>
                <field name="prerequisite_id"/>
                <field name="number_credits"/>
                <field name="credit_value"/>
                <field name="cost_subject"/>
                <field name="student_count"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

    <record id="view_open_academy_subject_form" model="ir.ui.view">
        <field name="name">view.open.academy.subject.form</field>
        <field name="model">open.academy.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_enrolled_students"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users">
                        <field name="student_count" widget="statinfo" string="Inscribed"/>
                    </button>
                </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="program_id"/>
                            <field name="is_global"/>
                            <field name="category"/>
                            <field name="semester"/>
                            <field name="prerequisite_id" 
                                    domain="[('program_id', '=', program_id), ('id', '!=', id)]"
                                    options="{'no_create': True, 'no_open': True}"/>
                                                            <field name="credit_value"/>
                        </group>

                        <group>
                            <field name="number_credits"/>
                            <field name="credit_value"/>
                            <field name="cost_subject" readonly="1"/>
                            <field name="max_enroll"/>
                            <field name="student_count" readonly="1"/>
                            <field name="teacher_id"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_open_academy_subject_search" model="ir.ui.view">
        <field name="name">view.open.academy.subject.search</field>
        <field name="model">open.academy.subject</field>
        <field name="arch" type="xml">

            <search string="Search Subjects">

                <field name="name"/>
                <field name="program_id"/>
                <field name="teacher_id"/>
                <field name="category"/>

               <filter name="basic"
                        string="Basic Mandatory"
                        domain="[('category','=','basic')]"/>

                <filter name="extrinsic"
                        string="Extrinsic Mandatory"
                        domain="[('category','=','extrinsic')]"/>

                <filter name="elective"
                        string="Elective"
                        domain="[('category','=','elective')]"/>


                <group> 

                    <filter name="_group_program" 
                            string="Program"
                            context="{'group_by': 'program_id'}"/>

                    <filter name="semester" 
                            string="Semester"
                            context="{'group_by': 'semester'}"/> 

                    <filter name="teacher" 
                            string="Teacher"
                            context="{'group_by': 'teacher_id'}"/>

                     <filter name="category"
                            string="Category"
                            context="{'group_by': 'category'}"/>

                </group> 

            </search>

        </field>
    </record>


    <record id="action_open_academy_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">open.academy.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_open_academy_subject_search"/>
    </record>

</odoo>
